DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
AEGIS_TRUST_PROXY_HEADERS=false
AEGIS_REQUEST_STREAM=aegis:requests
AEGIS_REQUEST_CONSUMER_GROUP=aegis-request-loggers
AEGIS_REQUEST_STREAM_MAX_LENGTH=100000
AEGIS_REQUEST_BATCH_SIZE=100
AEGIS_REQUEST_CLAIM_IDLE_MS=60000
AEGIS_REDIS_SOCKET_TIMEOUT_SECONDS=0.01
